<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3">
        <h2 class="h5 mb-1">Cadastrar Novo Livro</h2>
        <small class="text-muted">Preencha os dados do exemplar para o catálogo</small>
      </div>

      <div class="card-body p-4">
        <% if @book.errors.any? %>
          <div class="alert alert-danger" role="alert">
            <h6 class="alert-heading">Corrija os erros antes de continuar:</h6>
            <ul class="mb-0">
              <% @book.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @book, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :title, "Título do Livro", class: "form-label fw-semibold" %>
            <%= f.text_field :title, class: "form-control", placeholder: "Ex: Dom Casmurro", required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :author, "Autor", class: "form-label fw-semibold" %>
            <%= f.text_field :author, class: "form-control", placeholder: "Ex: Machado de Assis", required: true %>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-7">
              <%= f.label :isbn, "ISBN", class: "form-label fw-semibold" %>
              <%= f.text_field :isbn, class: "form-control font-monospace", placeholder: "9788535914849", required: true %>
            </div>
            <div class="col-md-5">
              <%= f.label :total_copies, "Exemplares", class: "form-label fw-semibold" %>
              <%= f.number_field :total_copies, min: 1, value: @book.total_copies || 1, class: "form-control", required: true %>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <%= link_to "Cancelar", root_path, class: "btn btn-outline-secondary" %>
            <%= f.submit "Salvar Livro", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>